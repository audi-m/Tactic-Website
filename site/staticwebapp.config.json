{
  "trailingSlash": "never",
  "routes": [
    { "route": "/user-authentication/*", "redirect": "https://app.tacticu.com/register-tenant", "statusCode": 301 },
    { "route": "/home", "redirect": "/", "statusCode": 301 },
    { "route": "/features", "redirect": "/feature", "statusCode": 301 },
    { "route": "/integrations", "redirect": "/integration", "statusCode": 301 },
    { "route": "/pricing", "redirect": "/pricing-plan", "statusCode": 301 },
    { "route": "/assets/*", "headers": { "cache-control": "public, max-age=604800" } },
    { "route": "/images/*", "headers": { "cache-control": "public, max-age=2592000" } }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN"
  }
}
